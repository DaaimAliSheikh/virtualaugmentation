# Public build-time settings (safe to commit; nothing secret lives here).

# Canonical origin, no trailing slash. Used for canonical URLs, Open Graph tags,
# JSON-LD, sitemap.xml and robots.txt. Change it here and every page follows.
VITE_SITE_URL=https://virtualaugmentation.com

# Address shown on the site (footer, contact page) and offered as the fallback
# when a form cannot send.
VITE_CONTACT_EMAIL=support@virtualaugmentation.com

# Where the forms POST. /api/contact is the site's own serverless function (api/contact.js);
# its SMTP settings are secrets and live in Vercel, never in this file (see .env.example).
# Leave empty to fall back to opening the visitor's email app.
VITE_FORM_ENDPOINT=/api/contact

# Social profiles linked from the footer. Replace with the real profile URLs.
VITE_SOCIAL_INSTAGRAM=https://www.instagram.com/
VITE_SOCIAL_X=https://x.com/
VITE_SOCIAL_LINKEDIN=https://www.linkedin.com/
VITE_SOCIAL_FACEBOOK=https://www.facebook.com/
