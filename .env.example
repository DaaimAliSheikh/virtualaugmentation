# Secrets for the contact form function (api/contact.js). Never commit real values.
#
# Production: add these in Vercel > Project > Settings > Environment Variables, then redeploy.
# Local testing: copy this file to .env.local (git-ignored) and fill it in.

# Mailbox that sends the enquiries (a Hostinger mailbox on your domain)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=you@yourdomain.com
SMTP_PASS=

# Optional
MAIL_FROM=you@yourdomain.com
MAIL_TO=you@yourdomain.com
MAIL_FROM_NAME=Website Contact Form
# Comma-separated origins allowed to call the function
ALLOWED_ORIGIN=https://virtualaugmentation.com,https://www.virtualaugmentation.com
